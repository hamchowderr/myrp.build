{
  "name": "myrp-build",
  "version": "0.1.2",
  "description": "AI-powered resource generator for FiveM server developers",
  "main": "./out/main/index.js",
  "author": "Otaku Solutions",
  "homepage": "https://myrp.build",
  "license": "FSL-1.1-ALv2",
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --write --unsafe .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "dev:secrets": "infisical run --projectId e56e0da5-6460-4bab-bdd6-2fd12ac5447b --env dev --recursive --silent -- electron-vite dev",
    "dev:prod": "infisical run --projectId e56e0da5-6460-4bab-bdd6-2fd12ac5447b --env prod --path /myrp-build --recursive --silent -- electron-vite dev",
    "dev:auth": "node scripts/dev-auth.mjs",
    "db:drift-check": "node scripts/db-drift-check.mjs",
    "deps:check": "node scripts/deps-check.mjs",
    "db:seed-corpus": "node scripts/seed-ox-corpus.mjs",
    "ox:currency": "node scripts/check-ox-currency.mjs",
    "build": "npm run typecheck && electron-vite build --mode development",
    "build:prod": "npm run typecheck && infisical run --projectId e56e0da5-6460-4bab-bdd6-2fd12ac5447b --env prod --path /myrp-build --recursive --silent -- electron-vite build --mode production",
    "postinstall": "electron-builder install-app-deps",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:unpack": "npm run clean && npm run build:prod && electron-builder --dir",
    "build:unpack:nosign": "npm run clean && npm run build:prod && electron-builder --dir --config electron-builder.nosign.yml",
    "build:unpack:e2e": "npm run clean && npm run build:prod && electron-builder --dir --config electron-builder.e2e.yml",
    "build:win": "npm run clean && npm run build:prod && electron-builder --win",
    "release:check": "node scripts/release.mjs --check",
    "release:win": "npm run clean && npm run build:prod && node scripts/release.mjs",
    "build:mac": "npm run clean && npm run build:prod && electron-builder --mac",
    "build:linux": "npm run clean && npm run build:prod && electron-builder --linux",
    "fallow": "fallow",
    "fallow:audit": "fallow audit",
    "fallow:fix": "fallow fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "studio": "mastra dev --dir studio --env .env",
    "prepare": "husky"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "@electron/asar": "^4.2.1",
    "@electron/universal": "^3.0.6",
    "ejs": "^6.0.1",
    "@hono/node-server": "^2.1.11"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.110",
    "@ai-sdk/openai": "^4.0.125",
    "@ai-sdk/react": "^4.0.188",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@mastra/ai-sdk": "^1.12.1",
    "@mastra/core": "^1.86.0",
    "@mastra/fastembed": "^1.4.0",
    "@mastra/memory": "^1.41.3",
    "@mastra/pg": "^1.38.0",
    "@msgpack/msgpack": "^3.1.3",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@streamdown/code": "^1.1.1",
    "@supabase/supabase-js": "^2.119.2",
    "@types/pg": "^8.23.1",
    "ai": "^7.0.183",
    "anser": "^2.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^17.4.2",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.12",
    "koffi": "^2.16.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "mysql2": "^3.24.6",
    "nanoid": "^5.1.16",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "react-resizable-panels": "^3.0.6",
    "shiki": "^4.6.0",
    "sonner": "^1.7.4",
    "streamdown": "^2.8.1",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@copilotkit/aimock": "^1.48.1",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@mastra/editor": "^0.17.3",
    "@mastra/mcp": "^1.18.0",
    "@mastra/observability": "^1.24.3",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/leaflet": "^1.9.23",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.8.13",
    "electron-builder": "^26.18.1",
    "electron-vite": "^5.0.0",
    "fallow": "^3.50.0",
    "husky": "^9.1.7",
    "mastra": "^1.40.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup-plugin-visualizer": "^7.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.7"
  }
}
